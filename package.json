{
  "name": "focus-board",
  "version": "1.0.0",
  "private": true,
  "description": "A simple ADHD-friendly daily planner: today list, weekly goals, daily habits, goals by life area and history.",
  "type": "module",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "test": "node --test \"tests/unit/*.test.js\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/*.test.js\"",
    "test:all": "npm test && npm run test:e2e"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  },
  "engines": {
    "node": ">=20"
  }
}
